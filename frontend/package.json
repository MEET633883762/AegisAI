{
  "name": "aegisai-static-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:dashboard": "vite --host 0.0.0.0 --port 5174 --strictPort --open /local-dashboard.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:release": "node --test ../tests/frontend/static_release.test.js",
    "test": "npm run typecheck && npm run build && npm run test:unit && npm run test:release"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
